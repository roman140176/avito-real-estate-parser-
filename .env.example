PORT=3000
HEADLESS=true
ALLOW_MANUAL_CAPTCHA=false
CAPTCHA_WAIT_MS=180000
# Включайте только в изолированном окружении, где Chromium без sandbox не запускается.
PUPPETEER_NO_SANDBOX=false
# Локальная сессия Chrome. Папка исключена из Git.
BROWSER_PROFILE_DIR=./.local/browser-profile
# Выгрузки. Папка исключена из Git.
DATA_DIR=./data
DEFAULT_PAGES=1
MAX_PAGES=10
PAGE_FETCH_RETRIES=3

# Пример:
# AVITO_PROXY_SERVER=http://123.123.123.123:8080
AVITO_PROXY_SERVER=
AVITO_PROXY_USERNAME=
AVITO_PROXY_PASSWORD=
